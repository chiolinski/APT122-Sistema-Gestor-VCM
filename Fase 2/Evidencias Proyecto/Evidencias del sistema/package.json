{
  "name": "vcm-piloto-2026-local",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5176 --strictPort",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test test/*.test.js",
    "preview": "vite preview --host 127.0.0.1 --port 4176 --strictPort",
    "local:configure": "node scripts/local-config.cjs",
    "local:infra": "docker compose up -d",
    "local:stop": "docker compose stop",
    "local:setup": "node scripts/local-setup.cjs",
    "local:api": "npm --prefix api start",
    "test:api": "npm --prefix api test",
    "test:isolation": "node --test api/test/localIsolation.test.js",
    "local:verify": "npm run test:isolation && npm run lint && npm test && npm run test:api && npm run build"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/react": "16.3.0",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "26.1.0",
    "vite": "^6.0.5"
  }
}
